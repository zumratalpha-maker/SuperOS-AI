# 本地守门模型（Ollama，如 Llama3.2 3B）- 仅做意图分类，省显存
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=llama3.2
OPENAI_API_KEY=ollama

# 云端大模型 API（OpenAI 兼容：DeepSeek/Groq/OpenAI）- 复杂 A11y 多步规划
# 即 API_BASE_URL / API_KEY / API_MODEL_NAME，填入 .env 即可
CLOUD_API_BASE_URL=https://api.deepseek.com/v1
CLOUD_API_KEY=sk-dd81926e68b5458589bbd09065cac16b
CLOUD_API_MODEL=deepseek-chat

# 混合路由：1 或 true 启用「本地分类 + 云端复杂规划」
HYBRID_ROUTER=1

# 可选：本地分类超时（毫秒）
# LOCAL_CLASSIFY_TIMEOUT_MS=10000

# DirectShell 配置（可选）
# DS_PROFILES=D:\DirectShell\ds_profiles
