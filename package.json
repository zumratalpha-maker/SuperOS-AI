    "verify:jianying-import": "tsx scripts/verify-jianying-import.ts",
    "verify:copywriting": "tsx scripts/verify-copywriting.ts",
    "verify:text-to-image": "tsx scripts/verify-text-to-image.ts",
    "verify:web-gen": "tsx scripts/verify-web-gen.ts",
    "verify:e2e-pipeline": "tsx scripts/verify-e2e-pipeline.ts",
    "diagnose:eyes": "tsx scripts/diagnose-eyes.ts",
    "learn:jianying": "tsx scripts/learn-jianying.ts",
    "learn:jianying:feedback": "tsx scripts/learn-jianying-feedback.ts",
    "learn:ui": "tsx src/learn-ui/server.ts",
    "learn:prepare-vosk": "node scripts/download-vosk-model.js",
    "verify:core": "tsx scripts/verify-core-modules.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "dashboard": "tsx src/dashboard/api.ts",
